{
  "name": "@independo/capacitor-inderun",
  "version": "1.3.0",
  "description": "On-device AI and speech for Capacitor apps: Apple Foundation Models, Gemini Nano, ONNX models and system or neural voices behind one API. Cloud only when you allow it.",
  "license": "MIT",
  "homepage": "https://inderun.dev/docs/getting-started/capacitor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/independo-gmbh/capacitor-inderun.git"
  },
  "bugs": {
    "url": "https://github.com/independo-gmbh/capacitor-inderun/issues"
  },
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "ionic",
    "inderun",
    "ai",
    "llm",
    "on-device",
    "on-device-ai",
    "local-llm",
    "offline",
    "streaming",
    "openai",
    "gemini-nano",
    "ml-kit",
    "foundation-models",
    "speech",
    "text-to-speech",
    "tts",
    "onnx"
  ],
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "android",
    "ios",
    "!ios/CIProbe",
    "Package.swift",
    "README.md"
  ],
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "lint": "tsc --noEmit -p tsconfig.json",
    "sync:markers": "node scripts/sync-markers.mjs --write",
    "check:markers": "node scripts/sync-markers.mjs --check",
    "check:snippets": "node scripts/check-snippets.mjs",
    "test": "vitest run",
    "test:web": "vitest run",
    "test:android": "cd android && ./gradlew :testDebugUnitTest",
    "test:ios": "swift test",
    "verify:web": "tsc -p tsconfig.json",
    "verify:android": "cd android && ./gradlew assembleDebug",
    "verify:ios": "swift build"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@independo/inderun-contracts": "0.5.0",
    "@independo/inderun-web": "0.5.0"
  },
  "devDependencies": {
    "@saithodev/semantic-release-backmerge": "^4.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.13.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.5",
    "typescript": "^7.0.2",
    "vite": "^7.3.8",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  }
}
