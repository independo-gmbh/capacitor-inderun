{
  "$comment": "Type-checks every README code example against the plugin's own source, not the npm package. Files marked TODO(verify) are excluded by scripts/check-snippets.mjs.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "paths": {
      "@independo/capacitor-inderun": ["../src/index.ts"]
    }
  },
  "include": ["*.ts"]
}
